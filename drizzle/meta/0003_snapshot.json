          "value": "\"transactions\".\"fx_source\" IN ('identity', 'manual', 'sample', 'frankfurter')"
        },
        "transactions_fx_rate_date_shape": {
          "name": "transactions_fx_rate_date_shape",
          "value": "\"transactions\".\"fx_rate_date\" IS NULL OR (length(\"transactions\".\"fx_rate_date\") = 10 AND \"transactions\".\"fx_rate_date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]')"
        },
        "transactions_fx_provenance": {
          "name": "transactions_fx_provenance",
          "value": "(\"transactions\".\"fx_source\" = 'frankfurter' AND \"transactions\".\"fx_rate_date\" IS NOT NULL) OR (\"transactions\".\"fx_source\" <> 'frankfurter' AND \"transactions\".\"fx_rate_date\" IS NULL)"
        },
        "transactions_timestamps_positive": {
          "name": "transactions_timestamps_positive",
          "value": "\"transactions\".\"fx_captured_at_ms\" > 0 AND \"transactions\".\"created_at_ms\" > 0 AND \"transactions\".\"updated_at_ms\" >= \"transactions\".\"created_at_ms\""
        },
        "transactions_base_currency_usd": {
          "name": "transactions_base_currency_usd",
          "value": "\"transactions\".\"base_currency\" = 'USD' AND \"transactions\".\"base_currency_exponent\" = 2"
        },
        "transactions_identity_conversion": {
          "name": "transactions_identity_conversion",
          "value": "(\"transactions\".\"original_currency\" = 'USD' AND \"transactions\".\"fx_source\" = 'identity' AND \"transactions\".\"fx_rate\" = '1' AND \"transactions\".\"original_amount_minor\" = \"transactions\".\"base_amount_minor\") OR (\"transactions\".\"original_currency\" <> 'USD' AND \"transactions\".\"fx_source\" <> 'identity')"
        },
        "transactions_category_length": {
          "name": "transactions_category_length",
          "value": "length(\"transactions\".\"category\") BETWEEN 1 AND 40"
        },
        "transactions_description_length": {
          "name": "transactions_description_length",
          "value": "length(\"transactions\".\"description\") BETWEEN 1 AND 120"
        },
        "transactions_note_length": {
          "name": "transactions_note_length",
          "value": "length(\"transactions\".\"note\") <= 500"
        },
        "transactions_recurrence": {
          "name": "transactions_recurrence",
          "value": "(\"transactions\".\"recurring_series_id\" IS NULL AND \"transactions\".\"recurrence_date\" IS NULL) OR (\"transactions\".\"recurring_series_id\" IS NOT NULL AND length(\"transactions\".\"recurrence_date\") = 10 AND \"transactions\".\"recurrence_date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]')"
        },
        "transactions_client_request_id_length": {
          "name": "transactions_client_request_id_length",
          "value": "\"transactions\".\"client_request_id\" IS NULL OR length(\"transactions\".\"client_request_id\") BETWEEN 1 AND 64"
        }
