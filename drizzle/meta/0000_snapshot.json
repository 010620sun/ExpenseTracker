      "checkConstraints": {
        "transactions_id_length": {
          "name": "transactions_id_length",
          "value": "length(\"transactions\".\"id\") BETWEEN 1 AND 64"
        },
        "transactions_kind": {
          "name": "transactions_kind",
          "value": "\"transactions\".\"kind\" IN ('expense', 'income')"
        },
        "transactions_occurred_on_shape": {
          "name": "transactions_occurred_on_shape",
          "value": "length(\"transactions\".\"occurred_on\") = 10 AND \"transactions\".\"occurred_on\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'"
        },
        "transactions_original_amount_range": {
          "name": "transactions_original_amount_range",
          "value": "\"transactions\".\"original_amount_minor\" > 0 AND \"transactions\".\"original_amount_minor\" <= 9000000000000"
        },
        "transactions_base_amount_range": {
          "name": "transactions_base_amount_range",
          "value": "\"transactions\".\"base_amount_minor\" >= 0 AND \"transactions\".\"base_amount_minor\" <= 9000000000000"
        },
        "transactions_original_currency_shape": {
          "name": "transactions_original_currency_shape",
          "value": "length(\"transactions\".\"original_currency\") = 3 AND \"transactions\".\"original_currency\" = upper(\"transactions\".\"original_currency\")"
        },
        "transactions_original_exponent_range": {
          "name": "transactions_original_exponent_range",
          "value": "\"transactions\".\"original_currency_exponent\" BETWEEN 0 AND 4"
        },
        "transactions_fx_rate_length": {
          "name": "transactions_fx_rate_length",
          "value": "length(\"transactions\".\"fx_rate\") BETWEEN 1 AND 32"
        },
        "transactions_fx_source": {
          "name": "transactions_fx_source",
          "value": "\"transactions\".\"fx_source\" IN ('identity', 'manual', 'sample')"
        },
        "transactions_timestamps_positive": {
          "name": "transactions_timestamps_positive",
          "value": "\"transactions\".\"fx_captured_at_ms\" > 0 AND \"transactions\".\"created_at_ms\" > 0 AND \"transactions\".\"updated_at_ms\" >= \"transactions\".\"created_at_ms\""
        },
        "transactions_base_currency_usd": {
          "name": "transactions_base_currency_usd",
          "value": "\"transactions\".\"base_currency\" = 'USD' AND \"transactions\".\"base_currency_exponent\" = 2"
        },
        "transactions_identity_conversion": {
          "name": "transactions_identity_conversion",
          "value": "\"transactions\".\"original_currency\" <> 'USD' OR (\"transactions\".\"fx_rate\" = '1' AND \"transactions\".\"original_amount_minor\" = \"transactions\".\"base_amount_minor\")"
        },
        "transactions_category_length": {
          "name": "transactions_category_length",
          "value": "length(\"transactions\".\"category\") BETWEEN 1 AND 40"
        },
        "transactions_description_length": {
          "name": "transactions_description_length",
          "value": "length(\"transactions\".\"description\") BETWEEN 1 AND 120"
        },
        "transactions_note_length": {
          "name": "transactions_note_length",
          "value": "length(\"transactions\".\"note\") <= 500"
        },
        "transactions_client_request_id_length": {
          "name": "transactions_client_request_id_length",
          "value": "\"transactions\".\"client_request_id\" IS NULL OR length(\"transactions\".\"client_request_id\") BETWEEN 1 AND 64"
        }
